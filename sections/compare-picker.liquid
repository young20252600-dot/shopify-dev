    .compare-picker--{{ uid }} .compare-picker__boolean-icon svg,
    .compare-picker--{{ uid }} .compare-picker__boolean-icon img {
      width: 100%;
      height: 100%;
      display: block;
    }
    .compare-picker--{{ uid }} .compare-picker__boolean-icon svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .compare-picker--{{ uid }} .compare-picker__boolean-icon--true {
      color: var(--boolean-icon-true-color);
    }
    .compare-picker--{{ uid }} .compare-picker__boolean-icon--false {
      color: var(--boolean-icon-false-color);
    }
    .compare-picker--{{ uid }} .compare-picker__field-label {
      margin-top: calc(4 * var(--vp-s));
      font-size: calc(12 * var(--vp-s));
      line-height: 1.35;
      font-weight: 400;
      color: rgba(0,0,0,0.46);
    }
    .compare-picker--{{ uid }} .compare-picker__swatches {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: calc(8 * var(--vp-s));
      line-height: 1;
    }
    .compare-picker--{{ uid }} .compare-picker__swatch {
      width: calc(18 * var(--vp-s));
      height: calc(18 * var(--vp-s));
      border-radius: 999px;
      background: var(--swatch);
      border: calc(1 * var(--vp-s)) solid rgba(0,0,0,0.14);
      box-shadow: inset 0 0 0 calc(1 * var(--vp-s)) rgba(255,255,255,0.5);
    }
