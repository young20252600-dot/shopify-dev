  {% if has_required_collections %}
    <script>
      (function () {
        var root = document.querySelector('.compare-picker--{{ uid }}');
        if (!root || root.getAttribute('data-compare-inited') === 'true') return;
        root.setAttribute('data-compare-inited', 'true');

        var dataEl = root.querySelector('[data-compare-products-json]');
        if (!dataEl) return;
        var list = [];
        try { list = JSON.parse(dataEl.textContent || '[]'); } catch (e) { list = []; }
        if (!Array.isArray(list) || !list.length) return;

        var map = {};
        list.forEach(function (p) { if (p && p.handle) map[p.handle] = p; });

        var selects = Array.prototype.slice.call(root.querySelectorAll('[data-selectors] select[data-slot]'));
        var fieldCells = Array.prototype.slice.call(root.querySelectorAll('[data-slot-cell][data-field-id]'));
        var cards = Array.prototype.slice.call(root.querySelectorAll('[data-slot-card]'));
        var pricePrefix = {{ section.settings.price_prefix | default: 'Starting at' | json }};
        var trueIconImage = {% if section.settings.boolean_icon_true_image != blank %}{{ section.settings.boolean_icon_true_image | image_url: width: 96 | json }}{% else %}''{% endif %};
        var falseIconImage = {% if section.settings.boolean_icon_false_image != blank %}{{ section.settings.boolean_icon_false_image | image_url: width: 96 | json }}{% else %}''{% endif %};
        root.classList.add('compare-picker--custom-selects');

        function closeCustomPickers(except) {
          root.querySelectorAll('.compare-picker__custom-select.is-open').forEach(function (picker) {
            if (except && picker === except) return;
            picker.classList.remove('is-open');
            var button = picker.querySelector('.compare-picker__custom-trigger');
            if (button) button.setAttribute('aria-expanded', 'false');
          });
        }

        function syncCustomPicker(selectEl) {
          if (!selectEl || !selectEl.comparePickerCustom) return;
          var custom = selectEl.comparePickerCustom;
          var selectedProduct = map[selectEl.value];
          var selectedText = selectedProduct ? (selectedProduct.title || selectedProduct.native_title || '') : '';
          if (!selectedText && selectEl.selectedOptions && selectEl.selectedOptions.length) {
            selectedText = selectEl.selectedOptions[0].textContent || '';
          }
          custom.button.textContent = selectedText || 'Select Product';
          custom.options.forEach(function (optionButton) {
            var isSelected = optionButton.getAttribute('data-value') === selectEl.value;
            optionButton.classList.toggle('is-selected', isSelected);
            optionButton.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          });
        }

        function buildCustomPicker(selectEl) {
          if (!selectEl || selectEl.comparePickerCustom) return;
          var selector = selectEl.closest('.compare-picker__selector');
          if (!selector) return;
          var pickerId = 'compare-picker-list-{{ uid }}-' + selectEl.getAttribute('data-slot');
          var custom = document.createElement('div');
          var button = document.createElement('button');
          var menu = document.createElement('div');
          var group = document.createElement('div');
          var optionButtons = [];

          custom.className = 'compare-picker__custom-select';
          button.className = 'compare-picker__custom-trigger';
          button.type = 'button';
          button.setAttribute('aria-haspopup', 'listbox');
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-controls', pickerId);
          button.disabled = selectEl.disabled;
          menu.className = 'compare-picker__custom-menu';
          menu.id = pickerId;
          menu.setAttribute('role', 'listbox');
          group.className = 'compare-picker__custom-group';
          group.textContent = selector.getAttribute('data-picker-label') || 'Select Product';
          menu.appendChild(group);

          Array.prototype.slice.call(selectEl.options).forEach(function (option) {
            if (!option.value) return;
            var product = map[option.value] || {};
            var optionButton = document.createElement('button');
            var thumb = document.createElement('img');
            var text = document.createElement('div');
            var title = document.createElement('div');
            var desc = document.createElement('div');

            optionButton.className = 'compare-picker__custom-option';
            optionButton.type = 'button';
            optionButton.setAttribute('role', 'option');
            optionButton.setAttribute('data-value', option.value);
            thumb.className = 'compare-picker__custom-thumb';
            thumb.loading = 'lazy';
            thumb.width = 80;
            thumb.height = 80;
            thumb.src = product.image || '';
            thumb.alt = product.image_alt || product.title || product.native_title || option.textContent || '';
            title.className = 'compare-picker__custom-title';
            title.textContent = product.title || product.native_title || option.textContent || '';
            desc.className = 'compare-picker__custom-desc';
            desc.textContent = product.desc || '';

            text.appendChild(title);
            if (desc.textContent) text.appendChild(desc);
            optionButton.appendChild(thumb);
            optionButton.appendChild(text);
            optionButton.addEventListener('click', function () {
              selectEl.value = option.value;
              syncCustomPicker(selectEl);
              updateSlot(parseInt(selectEl.getAttribute('data-slot'), 10), selectEl.value);
              closeCustomPickers();
            });
            menu.appendChild(optionButton);
            optionButtons.push(optionButton);
          });

          button.addEventListener('click', function () {
            if (button.disabled) return;
            var willOpen = !custom.classList.contains('is-open');
            closeCustomPickers(custom);
            custom.classList.toggle('is-open', willOpen);
            button.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          });

          custom.appendChild(button);
          custom.appendChild(menu);
          selector.appendChild(custom);
          selectEl.comparePickerCustom = { button: button, options: optionButtons };
          syncCustomPicker(selectEl);
        }

        function setCard(slot, product) {
          var card = cards.find(function (c) { return String(c.getAttribute('data-slot-card')) === String(slot); });
          if (!card) return;
          var img = card.querySelector('[data-slot-img]');
          var title = card.querySelector('[data-slot-title]');
          var price = card.querySelector('[data-slot-price]');
          var buy = card.querySelector('[data-slot-buy]');
          var link = card.querySelector('[data-slot-link]');
          var textLink = card.querySelector('[data-slot-link-text]');

          if (img) {
            img.src = product.image || '';
            img.alt = product.image_alt || product.native_title || product.title || '';
          }
          if (title) title.textContent = product.native_title || product.title || '';
          if (price) price.innerHTML = (pricePrefix ? pricePrefix + ' ' : '') + (product.price_html || '');
          if (buy) buy.href = product.url || '#';
          if (link) link.href = product.url || '#';
          if (textLink) textLink.href = product.url || '#';
        }

        function parseHexList(text) {
          if (!text) return null;
          var parts = text.split(/[,\/]\s*/).filter(function (p) { return !!p; });
          if (!parts.length) return null;
          var re = /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/;
          for (var i = 0; i < parts.length; i++) {
            if (!re.test(parts[i])) return null;
          }
          return parts;
        }

        function applyColorSwatches(cell) {
          if (!cell) return;
          var txt = (cell.textContent || '').replace(/\s+/g, ' ').trim();
          if (!txt) return;
          if (txt === '{{ empty_field_label | escape }}') return;
          var parts = parseHexList(txt);
          if (!parts) return;

          var html = '<span class="compare-picker__swatches" aria-hidden="true">';
          for (var i = 0; i < parts.length; i++) {
            html += '<span class="compare-picker__swatch" style="--swatch:' + parts[i] + '"></span>';
          }
          html += '</span><span class="visually-hidden">' + txt + '</span>';
          cell.innerHTML = html;
        }

        function getPlainFieldText(html) {
          var temp = document.createElement('div');
          temp.innerHTML = html || '';
          return (temp.textContent || temp.innerText || '').replace(/\s+/g, ' ').trim();
        }

        function getBooleanFieldValue(html) {
          var txt = getPlainFieldText(html).toLowerCase();
          if (txt === 'true') return true;
          if (txt === 'false') return false;
          return null;
        }

        function getBooleanIconHtml(value) {
          var isTrue = value === true;
          var iconUrl = isTrue ? trueIconImage : falseIconImage;
          var className = isTrue ? 'compare-picker__boolean-icon--true' : 'compare-picker__boolean-icon--false';
          var label = isTrue ? 'true' : 'false';
          var iconHtml = '';

          if (iconUrl) {
            iconHtml = '<img src="' + escapeHtml(iconUrl) + '" alt="" loading="lazy">';
          } else if (isTrue) {
            iconHtml = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"></path></svg>';
          } else {
            iconHtml = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12"></path></svg>';
          }

          return '<span class="compare-picker__boolean-icon ' + className + '" aria-hidden="true">' + iconHtml + '</span><span class="visually-hidden">' + label + '</span>';
        }

        function escapeHtml(text) {
          return String(text || '').replace(/[&<>"']/g, function (ch) {
            return {
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;'
            }[ch];
          });
        }

        function setFields(slot, product) {
          fieldCells.forEach(function (c) {
            if (String(c.getAttribute('data-slot-cell')) !== String(slot)) return;
            var fieldId = c.getAttribute('data-field-id');
            var val = product.fields && fieldId ? product.fields[fieldId] : '';
            var label = c.getAttribute('data-field-label') || '';
            var booleanValue = getBooleanFieldValue(val);
            var valueClass = booleanValue === null ? 'compare-picker__field-value' : 'compare-picker__field-value compare-picker__field-value--boolean';
            var valueHtml = booleanValue === null ? (val || '') : getBooleanIconHtml(booleanValue);
            c.innerHTML = '<div class="' + valueClass + '">' + valueHtml + '</div><div class="compare-picker__field-label">' + escapeHtml(label) + '</div>';
            if (booleanValue === null) {
              applyColorSwatches(c.querySelector('.compare-picker__field-value'));
            }
          });
        }

        function updateSlot(slot, handle) {
          var p = map[handle];
          if (!p) return;
          setCard(slot, p);
          setFields(slot, p);
        }

        function ensureSelection(selectEl) {
          if (!selectEl) return;
          if (selectEl.disabled) return;
          if (selectEl.value) return;
          if (selectEl.options && selectEl.options.length) {
            selectEl.selectedIndex = 0;
          }
        }

        selects.forEach(function (sel) {
          var slot = parseInt(sel.getAttribute('data-slot'), 10);
          ensureSelection(sel);
          buildCustomPicker(sel);
          sel.addEventListener('change', function () {
            syncCustomPicker(sel);
            updateSlot(slot, sel.value);
          });
        });

        document.addEventListener('click', function (event) {
          if (root.contains(event.target)) return;
          closeCustomPickers();
        });

        root.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') closeCustomPickers();
        });

        selects.forEach(function (sel) {
          var slot = parseInt(sel.getAttribute('data-slot'), 10);
          syncCustomPicker(sel);
          updateSlot(slot, sel.value);
        });
      })();
    </script>
  {% endif %}
</section>

{% schema %}
{
  "name": "Compare picker",
  "class": "section-compare-picker",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 16, "max": 64, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 14, "max": 44, "step": 1, "unit": "px", "default": 24 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
