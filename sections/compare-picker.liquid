      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #111;
      font-size: calc(14 * var(--vp-s));
      line-height: 1.35;
    }
    .compare-picker--{{ uid }} .compare-picker__table-body .compare-picker__table-row:nth-child(even) {
      background: rgba(0,0,0,0.02);
