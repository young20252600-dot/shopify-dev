<div class="hello-world-section" style="background-color: {{ section.settings.background_color }};">
  <div class="hello-world-content">
    <h1>Hello World</h1>
  </div>
</div>


{% schema %}
  {
    "name": "Hello World",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "背景颜色",
        "default": "#f5f5f5"
      }
    ],
    "presets": [
      {
        "name": "Hello World",
        "category": "Custom"
      }
    ]
  }
{% endschema %}

{% style %}
  .hello-world-section {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
    padding: 20px;
    width: 100%;
  }
  .hello-world-content {
    text-align: center;
  }
  .hello-world-content h1 {
    margin: 0;
    font-size: 2.5rem;
  }
{% endstyle %}